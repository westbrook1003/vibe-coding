# ===== 运行环境 =====
NODE_ENV=development
PORT=3000
# 允许跨域的前端地址，逗号分隔
CORS_ORIGIN=http://localhost:5173

# ===== 数据库 =====
# sqlite（默认，零配置，文件落在 backend/data/material-system.sqlite）
# mysql （把 DB_TYPE 改为 mysql 并补全下方连接串）
DB_TYPE=sqlite
DB_DATABASE=./data/material-system.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SYNCHRONIZE=true

# ===== 认证 =====
# 生产环境务必替换为随机长字符串
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=8h
# 登录失败锁定
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# 验证码有效期（分钟）与同一账号每小时发送上限
RESET_CODE_TTL_MINUTES=10
RESET_CODE_MAX_PER_HOUR=3

# ===== 内置管理员 =====
# 首次启动时自动创建，登录后强制改密
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
